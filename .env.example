NODE_ENV=production
PORT=8787
PUBLIC_BASE_URL=https://your-public-domain.example
FRONTEND_ORIGIN=https://your-frontend-domain.example
DH_DB_PATH=/data/digital-heroes.sqlite
# Frontend build-time values. These are public URLs, not secrets.
VITE_API_BASE_URL=https://your-backend-domain.example
VITE_PUBLIC_APP_ORIGIN=https://your-frontend-domain.example
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace_me
# Local only: true creates a local mock checkout and signed mock webhooks.
STRIPE_MOCK_MODE=false
# Optional local bootstrap credentials. Use a real identity provider in production.
DEMO_SUBSCRIBER_EMAIL=member@example.com
DEMO_SUBSCRIBER_PASSWORD=replace_me
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=replace_me
# Server-side Gemini support assistant configuration.
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.0-flash
# Optional MongoDB Atlas Data API mirror for winner workflow records and audit events.
MONGODB_DATA_API_URL=https://data.mongodb-api.com/app/replace_me/endpoint/data/v1
MONGODB_DATA_API_KEY=replace_me
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/digital_heroes
MONGODB_DATA_SOURCE=Cluster0
MONGODB_DATABASE=digital_heroes
MONGODB_WINNER_COLLECTION=winner_workflows
# GitHub Actions production Environment values. Store these in GitHub, not in this file.
# BACKEND_PUBLIC_URL=https://your-backend-domain.example
# FRONTEND_PUBLIC_URL=https://your-frontend-domain.example
# VERCEL_ORG_ID=team_replace_me
# VERCEL_PROJECT_ID=prj_replace_me
# VERCEL_TOKEN=vercel_token_injected_by_github
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv_replace_me?key=replace_me
